# Unity generated folders (root-level only — docs/Build is the committed WebGL build)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
MemoryCaptures/
Recordings/

# Never ignore asset meta files
!/[Aa]ssets/**/*.meta

# IDE / project files (regenerated by Unity)
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
*.stackdump
